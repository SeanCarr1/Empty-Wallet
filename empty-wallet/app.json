{
  "expo": {
    "name": "Empty-Wallet",
    "slug": "empty-wallet",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "emptywallet",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F1012",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F1012"
    },
    "androidStatusBar": {
      "backgroundColor": "#0F1012",
      "barStyle": "light-content"
    },
    "androidNavigationBar": {
      "backgroundColor": "#0F1012",
      "barStyle": "light-content"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emptywallet.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "Empty-Wallet uses Face ID to secure your financial data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F1012"
      },
      "package": "com.emptywallet.app",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Empty-Wallet to use Face ID."
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-sqlite",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
